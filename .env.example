# Copy to .env and fill in; .env is git-ignored. Placeholders only.

# Database password (hex avoids characters that need URL escaping): openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts webhook signing secrets at rest: openssl rand -hex 32
PYN_SECRET_KEY=

# Where people reach the server; an https:// address marks cookies Secure
PYN_PUBLIC_URL=http://localhost:7878

# Optional. Unset, the server prints a setup token in its log at first start.
# PYN_SETUP_TOKEN=

# Host address and port the server is published on (keep loopback behind a reverse proxy)
PYN_PUBLISH=127.0.0.1:7878

# Optional: PYN_REGISTRATION=invite|open|closed, PYN_ALLOWED_ORIGINS=https://pyn.example.com
# Behind a reverse proxy that sets X-Forwarded-For:
# PYN_TRUST_FORWARDED_FOR=true
