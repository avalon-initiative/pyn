# Copy to .env and fill in; docs/getting-started.md shows how. Placeholders only.

# The release to run, as the image tag: v0.0.2 (the version, without any title suffix)
PYN_VERSION=

# Database password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts webhook signing secrets at rest; keep it with your backups: openssl rand -hex 32
PYN_SECRET_KEY=

# PostgreSQL major version. Changing the major of an existing database needs a dump and restore, so leave it unless you plan that
# POSTGRES_VERSION=16

# The address people type in the browser; an https:// address marks cookies Secure
PYN_PUBLIC_URL=http://localhost:8080

# Where the web app listens on this machine; 0.0.0.0:8080 makes it reachable from other computers
# PYN_WEB_PUBLISH=127.0.0.1:8080

# Optional: PYN_REGISTRATION=invite|open|closed, PYN_SETUP_TOKEN=<16+ characters> to choose the setup token yourself
