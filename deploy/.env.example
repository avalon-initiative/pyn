# Copy to .env and fill in; docs/getting-started.md shows how. Placeholders only.

# The server release to run, as the image tag: v0.0.2 (the version, without any title suffix)
PYN_SERVER_VERSION=

# The web app release to run, as the image tag. It is versioned on its own, so it need not match the server
PYN_WEB_VERSION=

# Database password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts webhook signing secrets at rest; keep it with your backups: openssl rand -hex 32
PYN_SECRET_KEY=

# PostgreSQL major version. Changing the major of an existing database needs a dump and restore, so leave it unless you plan that
# POSTGRES_VERSION=16

# The address people type in the browser; an https:// address marks cookies Secure. With the Caddy option below, delete this
# line: Compose then uses https://<PYN_SITE>. A value set here always wins.
PYN_PUBLIC_URL=http://localhost:8080

# Where the web app listens on this machine; 0.0.0.0:8080 makes it reachable from other computers
# PYN_WEB_PUBLISH=127.0.0.1:8080

# Optional: PYN_REGISTRATION=invite|open|closed, PYN_SETUP_TOKEN=<16+ characters> to choose the setup token yourself

# Optional email, for address verification on an open server. Without it, open sign-up needs no address.
# PYN_MAILER=smtp
# PYN_SMTP_HOST=
# PYN_SMTP_PORT=587
# PYN_SMTP_USER=
# PYN_SMTP_PASSWORD=
# PYN_SMTP_FROM=
# PYN_SMTP_TLS=starttls
# For testing only: PYN_MAILER=log writes each message, links included, to the server log. Compose also needs
# PYN_MAILER_LOG_ALLOW_NON_LOOPBACK=true because the container listens on 0.0.0.0

# Optional: keep file content in an S3-compatible bucket (AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO) instead of the
# data volume, so several server copies can share it. docs/deployment.md#several-copies-on-a-bucket. The Compose file sets
# PYN_DATA_DIR, which cannot be combined with a bucket: remove that line (and the pyn-objects volume) first.
# PYN_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# PYN_S3_REGION=nyc3
# PYN_S3_BUCKET=
# PYN_S3_ACCESS_KEY_ID=
# PYN_S3_SECRET_ACCESS_KEY=
# Or read them from files instead (Docker or Kubernetes secrets): PYN_S3_ACCESS_KEY_ID_FILE, PYN_S3_SECRET_ACCESS_KEY_FILE
# PYN_S3_PREFIX=
# PYN_S3_PATH_STYLE=false

# Optional HTTPS: a caddy container in front of the web app (the installer's Caddy option writes these and ./Caddyfile).
# PYN_SITE is the host name or address people use, with no scheme or port. docs/deployment.md#https
# COMPOSE_PROFILES=caddy
# PYN_SITE=pyn.example.com
# Caddy then the web container are two proxies in front of the server. PYN_PUBLIC_URL (https://<PYN_SITE>) and
# PYN_TRUST_FORWARDED_FOR (true) follow from PYN_SITE and need not be set
# PYN_TRUSTED_PROXIES=2
# Where ports 80 and 443 (and 443/udp) are published; the default is all interfaces
# PYN_WEB_PUBLISH_HTTP=0.0.0.0:80
# PYN_WEB_PUBLISH_TLS=0.0.0.0:443
# A Caddy build with a DNS provider module, for a DNS challenge (advanced); the default is the official caddy image
# PYN_CADDY_IMAGE=

# Check this file and the Compose file before an upgrade: scripts/check-env.sh (docs/deployment.md#checking-your-env-before-an-upgrade)
