# Server only (docker-compose.server.yml). Copy to .env and fill in; docs/getting-started.md shows how. Placeholders only.

# The release to run, as the image tag: v0.0.2 (the version, without any title suffix)
PYN_VERSION=

# Database password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts webhook signing secrets at rest; keep it with your backups: openssl rand -hex 32
PYN_SECRET_KEY=

# PostgreSQL major version. Changing the major of an existing database needs a dump and restore, so leave it unless you plan that
# POSTGRES_VERSION=16

# The address people and web apps use to reach this server; an https:// address marks cookies Secure
PYN_PUBLIC_URL=http://localhost:7878

# Where the API listens on this machine; 0.0.0.0:7878 makes it reachable from other computers
# PYN_SERVER_PUBLISH=127.0.0.1:7878

# Optional: PYN_REGISTRATION=invite|open|closed, PYN_SETUP_TOKEN=<16+ characters> to choose the setup token yourself,
# PYN_ALLOWED_ORIGINS=<the address of a web app hosted elsewhere>
