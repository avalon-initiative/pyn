# Web app only (docker-compose.web.yml). Copy to .env and fill in; docs/getting-started.md shows how. Placeholders only.

# The release to run, as the image tag: v0.0.2 (the version, without any title suffix)
PYN_VERSION=

# The pyn server this web app talks to. That server must list this web app's address in its PYN_ALLOWED_ORIGINS
PYN_API_URL=

# Where the web app listens on this machine; 0.0.0.0:8080 makes it reachable from other computers
# PYN_WEB_PUBLISH=127.0.0.1:8080
